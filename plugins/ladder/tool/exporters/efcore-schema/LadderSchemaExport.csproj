<Project Sdk="Microsoft.NET.Sdk">
  <!-- Ladder schema exporter for EF Core: see README.md in this folder for how to run it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- NuGet's restore drops a global TargetFramework, so the framework is its own property:
         -p:LadderTargetFramework=net9.0 to match a models project that targets net9.0. -->
    <!-- By default, the framework the models project targets (round 19: net8.0 against a net9.0 models project failed with
         NU1201, and the hint was only in this folder's README). -->
    <LadderTargetFramework Condition="'$(LadderTargetFramework)' == '' and '$(ModelsProject)' != '' and Exists('$(ModelsProject)')">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(ModelsProject)')), '&lt;TargetFramework&gt;\s*([^&lt;;\s]+)').Groups[1].Value)</LadderTargetFramework>
    <LadderTargetFramework Condition="'$(LadderTargetFramework)' == ''">net8.0</LadderTargetFramework>
    <TargetFramework>$(LadderTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <ProjectReference Include="$(ModelsProject)" Condition="'$(ModelsProject)' != ''" />
  </ItemGroup>
  <Target Name="LadderNeedsModels" BeforeTargets="Build" Condition="'$(ModelsProject)' == ''">
    <Error Text="Pass -p:ModelsProject=/path/to/the/project/with/your/DbContexts.csproj" />
  </Target>
</Project>
